<%= form_with(model: reply_request) do |form| %>
  <% if reply_request.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(reply_request.errors.count, "error") %> prohibited this reply_request from being saved:</h2>

      <ul>
        <% reply_request.errors.each do |error| %>
          <li><%= error.full_message %></li>
